generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  module          String
  description     String?
  category        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  UserPermission  UserPermission[]

  @@index([code])
  @@index([module])
}

model Role {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  companyId          String?
  isSystemAdmin      Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdById        String?
  projectAssignments ProjectAssignment[]
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolePermissions    RolePermission[]
  users              User[]

  @@unique([companyId, name])
  @@index([companyId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  constraints  Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  grantedById  String?
  grantedBy    User?      @relation("PermissionGranter", fields: [grantedById], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([grantedById])
}

model Company {
  id                 String              @id @default(uuid())
  name               String
  registrationNumber String?             @unique
  gstNumber          String?             @unique
  officeAddress      String?
  officeLatitude     Float?
  officeLongitude    Float?
  officeGeofence     Float               @default(100)
  phone              String?
  email              String?
  website            String?
  logo               String?
  bankName           String?
  bankAccount        String?
  bankIfsc           String?
  bankBranch         String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdById        String?
  auditLogs          AuditLog[]
  budgets            Budget[]
  clients            Client[]
  createdBy          User?               @relation("CompanyCreator", fields: [createdById], references: [id])
  settings           CompanySettings?
  Contractor         Contractor[]
  ContractorProject  ContractorProject[]
  equipment          Equipment[]
  inventories        Inventory[]
  inventoryTransfers InventoryTransfer[]
  labourRates        LabourRate[]
  materials          Material[]
  payrolls           Payroll[]
  projects           Project[]
  projectCashboxes   ProjectCashbox[]
  purchaseOrders     PurchaseOrder[]
  roles              Role[]
  safetyChecks       SafetyCheck[]
  shiftTypes         ShiftType[]
  siteStaffs         SiteStaff[]
  suppliers          Supplier[]
  transactions       Transaction[]
  users              User[]

  @@index([name])
  @@index([createdById])
}

model User {
  id                                              String                     @id @default(uuid())
  companyId                                       String?
  roleId                                          String
  userType                                        UserType                   @default(EMPLOYEE)
  email                                           String?                    @unique
  phone                                           String                     @unique
  password                                        String
  employeeId                                      String?
  name                                            String
  designation                                     String?
  department                                      String?
  employeeStatus                                  EmployeeStatus             @default(ACTIVE)
  defaultLocation                                 AttendanceLocation         @default(OFFICE)
  salaryType                                      SalaryType                 @default(MONTHLY)
  salary                                          Float?
  hourlyRate                                      Float?
  dateOfBirth                                     DateTime?
  dateOfJoining                                   DateTime?
  address                                         String?
  emergencyContact                                String?
  emergencyPhone                                  String?
  profilePicture                                  String?
  aadharNumber                                    String?
  panNumber                                       String?
  bankAccount                                     String?
  ifscCode                                        String?
  refreshToken                                    String?
  resetPasswordToken                              String?
  resetPasswordExpiry                             DateTime?
  lastLogin                                       DateTime?
  emailVerified                                   Boolean                    @default(false)
  emailVerifiedAt                                 DateTime?
  phoneVerified                                   Boolean                    @default(false)
  phoneVerifiedAt                                 DateTime?
  accountSetupCompleted                           Boolean                    @default(false)
  accountSetupCompletedAt                         DateTime?
  isActive                                        Boolean                    @default(true)
  createdAt                                       DateTime                   @default(now())
  updatedAt                                       DateTime                   @updatedAt
  createdById                                     String?
  markedAttendances                               Attendance[]               @relation("AttendanceMarker")
  attendances                                     Attendance[]               @relation("AttendanceUser")
  verifiedAttendances                             Attendance[]               @relation("AttendanceVerifier")
  auditLogs                                       AuditLog[]
  budgetApprovals                                 Budget[]                   @relation("BudgetApprover")
  budgetCreations                                 Budget[]                   @relation("BudgetCreator")
  budgetLocks                                     Budget[]                   @relation("BudgetLocker")
  budgetRequests                                  Budget[]                   @relation("BudgetRequester")
  budgetAlerts                                    BudgetAlert[]              @relation("BudgetAlertCreator")
  budgetAlertResolves                             BudgetAlert[]              @relation("BudgetAlertResolver")
  budgetCategoryCreations                         BudgetCategoryAllocation[] @relation("BudgetCategoryCreator")
  budgetDocuments                                 BudgetDocument[]
  budgetForecasts                                 BudgetForecast[]           @relation("ForecastCreator")
  budgetRevisionApprovals                         BudgetRevision[]           @relation("RevisionApprover")
  budgetRevisions                                 BudgetRevision[]           @relation("RevisionCreator")
  budgetRevisionRequests                          BudgetRevision[]           @relation("RevisionRequester")
  budgetTransactions                              BudgetTransaction[]        @relation("BudgetTransactionCreator")
  createdClients                                  Client[]                   @relation("ClientCreator")
  createdCompanies                                Company[]                  @relation("CompanyCreator")
  createdContractors                              Contractor[]               @relation("ContractorCreator")
  supervisedAssignments                           ContractorAssignment[]     @relation("AssignmentSupervisor")
  verifiedAssignments                             ContractorAssignment[]     @relation("AssignmentVerifier")
  contractorDocs                                  ContractorDocument[]
  approvedContPayments                            ContractorPayment[]        @relation("ContractorPaymentApprover")
  createdContPayments                             ContractorPayment[]        @relation("ContractorPaymentCreator")
  createdContProjects                             ContractorProject[]        @relation("ContractorProjectCreator")
  approvedReviews                                 ContractorReview[]         @relation("ReviewApprover")
  contractorReviews                               ContractorReview[]         @relation("ReviewCreator")
  dprPhotos                                       DPRPhoto[]
  approvedDPRs                                    DailyProgressReport[]      @relation("DPRApprover")
  preparedDPRs                                    DailyProgressReport[]      @relation("DPRPreparer")
  documentsUploaded                               Document[]
  assignedEquipment                               Equipment[]                @relation("EquipmentUser")
  equipment                                       Equipment[]
  operatedEquipment                               EquipmentLog[]
  approvedExpenses                                Expense[]                  @relation("ExpenseApprover")
  createdExpenses                                 Expense[]                  @relation("ExpenseCreator")
  grCreations                                     GoodsReceipt[]             @relation("GRCreator")
  goodsInspections                                GoodsReceipt[]             @relation("GoodsInspector")
  goodsReceipts                                   GoodsReceipt[]             @relation("GoodsReceiver")
  itemInspections                                 GoodsReceiptItem[]         @relation("ItemInspector")
  approvedTransfers                               InventoryTransfer[]        @relation("TransferApprover")
  requestedTransfers                              InventoryTransfer[]        @relation("TransferRequester")
  inventoryTransfers                              InventoryTransfer[]
  approvedInvoices                                Invoice[]                  @relation("InvoiceApprover")
  createdInvoices                                 Invoice[]                  @relation("InvoiceCreator")
  approvedLabourRates                             LabourRate[]               @relation("LabourRateApprover")
  createdLabourRates                              LabourRate[]               @relation("LabourRateCreator")
  approvedLeaves                                  Leave[]                    @relation("LeaveApprover")
  leaves                                          Leave[]                    @relation("LeaveUser")
  createdMaterials                                Material[]                 @relation("MaterialCreator")
  consumedMaterials                               MaterialConsumption[]
  approvedMaterials                               MaterialRequest[]          @relation("MaterialApprover")
  orderedMaterials                                MaterialRequest[]          @relation("MaterialOrderer")
  materialRequests                                MaterialRequest[]          @relation("MaterialRequester")
  receivedMessages                                Message[]                  @relation("MessageReceiver")
  sentMessages                                    Message[]                  @relation("MessageSender")
  milestones                                      Milestone[]                @relation("MilestoneCreator")
  notifications                                   Notification[]
  createdPayments                                 Payment[]                  @relation("PaymentCreator")
  paymentsReceived                                Payment[]                  @relation("PaymentReceiver")
  approvedPayrolls                                Payroll[]                  @relation("PayrollApprover")
  createdPayrolls                                 Payroll[]                  @relation("PayrollCreator")
  paidPayrolls                                    Payroll[]                  @relation("PayrollPayer")
  processedPayrolls                               Payroll[]                  @relation("PayrollProcessor")
  createdProjects                                 Project[]                  @relation("ProjectCreator")
  projectAssignments                              ProjectAssignment[]
  projectCashboxCreations                         ProjectCashbox[]           @relation("ProjectCashboxCreator")
  poApprovals                                     PurchaseOrder[]            @relation("POApprover")
  poCancellations                                 PurchaseOrder[]            @relation("POCanceller")
  poClosures                                      PurchaseOrder[]            @relation("POCloser")
  poCreations                                     PurchaseOrder[]            @relation("POCreator")
  poHolds                                         PurchaseOrder[]            @relation("POHolder")
  poOrders                                        PurchaseOrder[]            @relation("POOrderer")
  poRequests                                      PurchaseOrder[]            @relation("PORequester")
  purchaseOrderComments                           PurchaseOrderComment[]
  purchaseOrderDocuments                          PurchaseOrderDocument[]
  purchaseOrderHistories                          PurchaseOrderHistory[]
  poPaymentApprovals                              PurchaseOrderPayment[]     @relation("POPaymentApprover")
  poPaymentCreations                              PurchaseOrderPayment[]     @relation("POPaymentCreator")
  grantedPermissions                              RolePermission[]           @relation("PermissionGranter")
  conductedSafetyChecks                           SafetyCheck[]              @relation("SafetyConductor")
  resolvedSafetyChecks                            SafetyCheck[]              @relation("SafetyResolver")
  shiftTypes                                      ShiftType[]                @relation("ShiftTypeCreator")
  siteStaffs                                      SiteStaff[]                @relation("SiteStaffCreator")
  siteStaffAssignmentsCreated                     SiteStaffAssignment[]      @relation("SiteStaffAssignmentCreator")
  resolvedStockAlerts                             StockAlert[]               @relation("StockAlertResolver")
  stockTransactions                               StockTransaction[]
  subtasks                                        Subtask[]                  @relation("SubtaskCreator")
  subtasksAssigned                                SubtaskAssignment[]        @relation("SubtaskAssigner")
  subtaskAssignmentsVerified                      SubtaskAssignment[]        @relation("SubtaskAssignmentVerifier")
  supplierBlacklists                              Supplier[]                 @relation("SupplierBlacklister")
  supplierCreations                               Supplier[]                 @relation("SupplierCreator")
  supplierVerifications                           Supplier[]                 @relation("SupplierVerifier")
  supplierDocuments                               SupplierDocument[]
  supplierDocVerifications                        SupplierDocument[]         @relation("SupplierDocVerifier")
  assignedTasks                                   Task[]                     @relation("TaskAssignee")
  createdTasks                                    Task[]                     @relation("TaskCreator")
  taskAttachments                                 TaskAttachment[]
  taskComments                                    TaskComment[]
  approvedTimelines                               Timeline[]                 @relation("TimelineApprovedBy")
  archivedTimelines                               Timeline[]                 @relation("TimelineArchivedBy")
  createdTimelines                                Timeline[]                 @relation("TimelineCreatedBy")
  lockedTimelines                                 Timeline[]                 @relation("TimelineLockedBy")
  timelineApprovalsToApprove                      TimelineApproval[]         @relation("TimelineApprovalApprover")
  timelineApprovalsRequested                      TimelineApproval[]         @relation("TimelineApprovalRequestedBy")
  timelineActions                                 TimelineHistory[]
  approvedTimelineVersions                        TimelineVersion[]          @relation("TimelineVersionApprovedBy")
  createdTimelineVersions                         TimelineVersion[]          @relation("TimelineVersionCreatedBy")
  submittedTimelineVersions                       TimelineVersion[]          @relation("TimelineVersionSubmittedBy")
  approvedTimesheets                              Timesheet[]                @relation("TimesheetApprover")
  timesheets                                      Timesheet[]                @relation("TimesheetUser")
  approvedTransactions                            Transaction[]              @relation("TransactionApprovedBy")
  rejectedTransactions                            Transaction[]              @relation("TransactionRejectedBy")
  requestedTransactions                           Transaction[]              @relation("TransactionRequestedBy")
  voidedTransactions                              Transaction[]              @relation("TransactionVoidedBy")
  company                                         Company?                   @relation(fields: [companyId], references: [id])
  createdBy                                       User?                      @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers                                    User[]                     @relation("UserCreator")
  role                                            Role                       @relation(fields: [roleId], references: [id])
  UserPermission_UserPermission_grantedByIdToUser UserPermission[]           @relation("UserPermission_grantedByIdToUser")
  UserPermission_UserPermission_userIdToUser      UserPermission[]           @relation("UserPermission_userIdToUser")
  settings                                        UserSettings?
  approvedWPRs                                    WeeklyProgressReport[]     @relation("WPRApprover")
  preparedWPRs                                    WeeklyProgressReport[]     @relation("WPRPreparer")
  workerAttendancesMarked                         WorkerAttendance[]         @relation("WorkerAttendanceMarker")
  workerAttendancesVerified                       WorkerAttendance[]         @relation("WorkerAttendanceVerifier")
  payrolls                                        Payroll[]                  @relation("PayrollToUser")
  safetyChecks                                    SafetyCheck[]              @relation("SafetyCheckToUser")
  stockAlerts                                     StockAlert[]               @relation("StockAlertToUser")

  @@unique([companyId, employeeId])
  @@index([email])
  @@index([phone])
  @@index([companyId])
  @@index([roleId])
  @@index([createdById])
}

model Client {
  id            String    @id @default(uuid())
  companyId     String
  companyName   String
  contactPerson String
  email         String?
  phone         String
  gstNumber     String?
  address       String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  company       Company   @relation(fields: [companyId], references: [id])
  createdBy     User?     @relation("ClientCreator", fields: [createdById], references: [id])
  invoices      Invoice[]
  payments      Payment[]
  projects      Project[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([createdById])
}

model Project {
  id                   String                 @id @default(uuid())
  projectId            String
  companyId            String
  clientId             String?
  name                 String
  description          String?
  location             String
  latitude             Float
  longitude            Float
  geofenceRadius       Float                  @default(200)
  estimatedBudget      Float
  actualBudget         Float?
  contractValue        Float?
  advanceReceived      Float?                 @default(0)
  status               ProjectStatus          @default(PLANNING)
  priority             Priority               @default(MEDIUM)
  progress             Int?                   @default(0) @db.SmallInt
  startDate            DateTime
  estimatedEndDate     DateTime
  actualEndDate        DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  createdById          String?
  activeBudgetId       String?                @unique
  totalBudget          Float?                 @default(0)
  totalExpenses        Float?                 @default(0)
  budgetUtilization    Float?                 @default(0)
  attendances          Attendance[]
  budgets              Budget[]
  ContractorProject    ContractorProject[]
  ContractorReview     ContractorReview[]
  dprs                 DailyProgressReport[]
  documents            Document[]
  currentEquipment     Equipment[]
  equipmentLogs        EquipmentLog[]
  expenses             Expense[]
  goodsReceipts        GoodsReceipt[]
  inventoryRecords     Inventory[]
  transfersOut         InventoryTransfer[]    @relation("TransferSource")
  transfersIn          InventoryTransfer[]    @relation("TransferDestination")
  invoices             Invoice[]
  batches              MaterialBatch[]
  consumptions         MaterialConsumption[]
  materialRequests     MaterialRequest[]
  messages             Message[]
  milestones           Milestone[]
  activeBudget         Budget?                @relation("ProjectActiveBudget", fields: [activeBudgetId], references: [id])
  client               Client?                @relation(fields: [clientId], references: [id])
  company              Company                @relation(fields: [companyId], references: [id])
  createdBy            User?                  @relation("ProjectCreator", fields: [createdById], references: [id])
  projectAssignments   ProjectAssignment[]
  cashbox              ProjectCashbox?
  projectSettings      ProjectSettings?
  purchaseOrders       PurchaseOrder[]
  safetyChecks         SafetyCheck[]
  siteStaffAssignments SiteStaffAssignment[]
  stockTransactions    StockTransaction[]
  subtaskAssignments   SubtaskAssignment[]
  tasks                Task[]
  timelines            Timeline[]
  timesheets           Timesheet[]
  transactions         Transaction[]
  wprs                 WeeklyProgressReport[]
  workerAttendances    WorkerAttendance[]
  materials            Material[]             @relation("ProjectMaterials")

  @@unique([companyId, projectId])
  @@index([companyId])
  @@index([clientId])
  @@index([createdById])
}

model ProjectAssignment {
  id          String    @id @default(uuid())
  userId      String
  projectId   String
  roleId      String?
  designation String?
  startDate   DateTime
  endDate     DateTime?
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role        Role?     @relation(fields: [roleId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, projectId, startDate])
  @@index([projectId])
  @@index([userId])
  @@index([roleId])
}

model Attendance {
  id                String             @id @default(uuid())
  userId            String
  locationType      AttendanceLocation
  projectId         String?
  date              DateTime           @db.Date
  status            AttendanceStatus   @default(PRESENT)
  checkInTime       DateTime?
  checkOutTime      DateTime?
  checkInLatitude   Float?
  checkInLongitude  Float?
  checkInAccuracy   Float?
  isWithinGeofence  Boolean?
  geofenceType      String?
  distanceFromBase  Float?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  checkInImageUrl   String?
  checkOutImageUrl  String?
  checkInNotes      String?
  checkOutNotes     String?
  deviceInfo        String?
  workingHours      Float?             @default(0)
  overtimeHours     Float?             @default(0)
  totalHours        Float?             @default(0)
  isVerified        Boolean            @default(false)
  verificationNotes String?
  verifiedById      String?
  verifiedAt        DateTime?
  markedById        String?
  leaveType         LeaveType?
  leaveReason       String?
  notes             String?
  timesheetId       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  markedBy          User?              @relation("AttendanceMarker", fields: [markedById], references: [id])
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timesheet         Timesheet?         @relation(fields: [timesheetId], references: [id])
  user              User               @relation("AttendanceUser", fields: [userId], references: [id])
  verifiedBy        User?              @relation("AttendanceVerifier", fields: [verifiedById], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([projectId])
  @@index([date])
  @@index([markedById])
  @@index([verifiedById])
}

model Timesheet {
  id              String       @id @default(uuid())
  userId          String
  projectId       String?
  weekStartDate   DateTime     @db.Date
  weekEndDate     DateTime     @db.Date
  regularHours    Float        @default(0)
  overtimeHours   Float        @default(0)
  totalHours      Float        @default(0)
  status          String       @default("PENDING")
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  attendances     Attendance[]
  approvedBy      User?        @relation("TimesheetApprover", fields: [approvedById], references: [id])
  project         Project?     @relation(fields: [projectId], references: [id])
  user            User         @relation("TimesheetUser", fields: [userId], references: [id])

  @@unique([userId, projectId, weekStartDate])
  @@index([userId])
  @@index([projectId])
}

model Payroll {
  id                 String              @id @default(uuid())
  payrollNo          String              @unique
  companyId          String
  periodFrom         DateTime
  periodTo           DateTime
  periodType         String
  status             PayrollStatus       @default(PENDING)
  processedAt        DateTime?
  processedById      String?
  paidAt             DateTime?
  paidById           String?
  paymentMethod      PaymentMethod?
  paymentReference   String?
  totalWorkers       Int                 @default(0)
  totalDays          Float               @default(0)
  totalAmount        Float               @default(0)
  totalDeductions    Float               @default(0)
  totalBonus         Float               @default(0)
  netAmount          Float               @default(0)
  notes              String?
  approvedById       String?
  approvedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdById        String?
  budgetTransactions BudgetTransaction[]
  approvedBy         User?               @relation("PayrollApprover", fields: [approvedById], references: [id])
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy          User?               @relation("PayrollCreator", fields: [createdById], references: [id])
  paidBy             User?               @relation("PayrollPayer", fields: [paidById], references: [id])
  processedBy        User?               @relation("PayrollProcessor", fields: [processedById], references: [id])
  items              PayrollItem[]
  transactions       Transaction[]
  users              User[]              @relation("PayrollToUser")

  @@unique([companyId, payrollNo])
  @@index([companyId])
  @@index([periodFrom, periodTo])
  @@index([status])
}

model Equipment {
  id                 String                  @id @default(uuid())
  companyId          String
  name               String
  code               String?                 @unique
  type               String
  model              String?
  serialNumber       String?                 @unique
  registrationNumber String?
  location           InventoryLocation       @default(GLOBAL)
  currentProjectId   String?
  ownershipType      OwnershipType           @default(OWNED)
  rentalProvider     String?
  rentalRate         Float?
  rentalUnit         String?
  purchaseDate       DateTime?
  purchaseCost       Float?
  fuelType           FuelType?
  fuelConsumption    Float?
  status             EquipmentStatus         @default(AVAILABLE)
  condition          String?
  manufacturer       String?
  year               Int?
  lastServiceDate    DateTime?
  nextServiceDate    DateTime?
  assignedToId       String?
  assignedDate       DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  createdById        String?
  budgetTransactions BudgetTransaction[]
  assignedTo         User?                   @relation("EquipmentUser", fields: [assignedToId], references: [id])
  company            Company                 @relation(fields: [companyId], references: [id])
  createdBy          User?                   @relation(fields: [createdById], references: [id])
  project            Project?                @relation(fields: [currentProjectId], references: [id])
  logs               EquipmentLog[]
  transferItems      InventoryTransferItem[]

  @@index([companyId])
  @@index([currentProjectId])
  @@index([ownershipType])
}

model EquipmentLog {
  id                 String    @id @default(uuid())
  equipmentId        String
  projectId          String
  date               DateTime
  startTime          DateTime?
  endTime            DateTime?
  totalHours         Float
  billableHours      Float?
  rentalRateSnapshot Float?
  rentalCost         Float?
  fuelConsumed       Float?
  fuelRate           Float?
  fuelCost           Float?
  totalCost          Float
  workDescription    String?
  operatorId         String?
  operatorName       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  equipment          Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  operator           User?     @relation(fields: [operatorId], references: [id])
  project            Project   @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([equipmentId])
  @@index([date])
}

model SafetyCheck {
  id                String       @id @default(uuid())
  projectId         String
  companyId         String
  conductedById     String
  date              DateTime
  checklist         Json
  status            SafetyStatus
  issuesFound       String?
  correctiveActions String?
  followUpDate      DateTime?
  isResolved        Boolean      @default(false)
  resolvedAt        DateTime?
  resolvedById      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  company           Company      @relation(fields: [companyId], references: [id])
  conductedBy       User         @relation("SafetyConductor", fields: [conductedById], references: [id])
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resolvedBy        User?        @relation("SafetyResolver", fields: [resolvedById], references: [id])
  users             User[]       @relation("SafetyCheckToUser")

  @@index([projectId])
}

model Milestone {
  id            String     @id @default(uuid())
  name          String
  description   String?
  amount        Float?
  projectId     String
  status        TaskStatus @default(TODO)
  dueDate       DateTime
  completedDate DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  createdById   String?
  createdBy     User?      @relation("MilestoneCreator", fields: [createdById], references: [id])
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Task {
  id                       String              @id @default(uuid())
  title                    String
  description              String?
  projectId                String
  assignedToId             String?
  createdById              String
  status                   TaskStatus          @default(TODO)
  priority                 Priority            @default(MEDIUM)
  progress                 Int?                @default(0) @db.SmallInt
  startDate                DateTime?
  dueDate                  DateTime?
  completedDate            DateTime?
  estimatedHours           Float?
  actualHours              Float?              @default(0)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  subtasks                 Subtask[]
  subtaskWorkerAssignments SubtaskAssignment[]
  assignedTo               User?               @relation("TaskAssignee", fields: [assignedToId], references: [id])
  creator                  User                @relation("TaskCreator", fields: [createdById], references: [id])
  project                  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments              TaskAttachment[]
  comments                 TaskComment[]
  timelineTasks            TimelineTask[]

  @@index([projectId])
}

model Subtask {
  id          String              @id @default(uuid())
  description String
  isCompleted Boolean             @default(false)
  taskId      String
  createdAt   DateTime            @default(now())
