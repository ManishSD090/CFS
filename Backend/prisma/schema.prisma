  company             Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractorPayment   ContractorPayment?        @relation(fields: [contractorPaymentId], references: [id])
  invoice             Invoice?                  @relation("InvoiceTransactions", fields: [invoiceId], references: [id])
  payment             Payment?                  @relation("PaymentTransactions", fields: [paymentId], references: [id])
  payroll             Payroll?                  @relation(fields: [payrollId], references: [id])
  project             Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
