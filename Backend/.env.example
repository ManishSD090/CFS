# Database Configuration
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Authentication & Security
JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
BCRYPT_SALT_ROUNDS=10

# Server Configuration
PORT=5001
NODE_ENV="production"
APP_URL="http://localhost:3000"
BASE_URL="http://your_server_ip:5001"
Base_URL="http://your_server_ip:5001"
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (SMTP) Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your_smtp_user"
SMTP_PASS="your_smtp_password"
SMTP_SECURE=false
EMAIL_FROM="Your App <noreply@example.com>"

# SMS Services Configuration
TWO_FACTOR_API_KEY="your_2fa_api_key"
TWO_FACTOR_SENDER_ID="NEECON"
FAST2SMS_API_KEY="your_fast2sms_api_key"
FAST2SMS_SENDER_ID="FSTSMS"

# Cloudflare R2 / S3 Storage (Optional - for persistent cloud storage)
CLOUDFLARE_R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_key"
CLOUDFLARE_R2_BUCKET_NAME="your_bucket_name"
CLOUDFLARE_R2_PUBLIC_DOMAIN="your_public_r2_domain.com"
USE_CLOUDFLARE=false

# Machine Learning Service Integration
ML_API_URL="http://127.0.0.1:8000"
